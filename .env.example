# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_PHONE_NUMBER=+15551234567

# Optional. Set to enable WhatsApp, which bills per 24-hour conversation window
# rather than per segment and gets cheaper than SMS as volume rises. Point the
# WhatsApp webhook at the same /message endpoint.
TWILIO_WHATSAPP_NUMBER=

# Optional escape hatch, defaults to on. Setting this to "false" disables
# verification that inbound webhooks really came from Twilio. Never do this in
# production: the endpoint is a public url, and without the check anyone can
# post someone else's number and drive their calendar.
TWILIO_VALIDATE_SIGNATURE=true

# Google OAuth
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# Your own deployment's public url. Kept as a placeholder on purpose: this repo
# is public, and naming the real host points anyone at the live endpoints.
GOOGLE_REDIRECT_URI=https://your-app.up.railway.app/oauth/callback

# Hard ceiling on everything this service spends in a calendar month, across
# all users combined. Covers anthropic tokens and twilio segments. When it is
# gone the agent and the reminder sweep stop; STOP and HELP keep working.
MONTHLY_BUDGET_USD=15

# Serves /docs, /redoc and /openapi.json. Off by default: this is a webhook
# backend with no human callers, and a public map of the endpoints only helps
# someone probing them. Turn on locally if you want the interactive docs.
EXPOSE_API_DOCS=false

# Leave this blank. Error monitoring works without it: failures are counted and
# summarised in the logs on a heartbeat, including on quiet ticks, so a silent
# failure is still visible. Setting it additionally sends errors to Sentry, and
# needs `pip install sentry-sdk` on top. Only worth it once you have real users
# and want to be told rather than to go looking.
SENTRY_DSN=

# Security
# Signs the OAuth state parameter. Any random 64-char hex string.
STATE_SECRET=your_64_char_hex_string_here

# Encrypts google refresh tokens at rest. Without it they are stored in
# plaintext and a database dump is permanent calendar access for every user.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key makes existing tokens unreadable — those users are asked to
# reconnect rather than silently failing, but it is not a free change.
TOKEN_ENCRYPTION_KEY=

# Database (Railway Postgres — auto-set if using Railway plugin)
DATABASE_URL=postgresql+asyncpg://postgres:password@host:5432/railway

# Connection pool is per process, so the real ceiling is these times the
# replica count. Keep pool_size + max_overflow under your Postgres limit.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis (Railway Redis — auto-set if using Railway plugin)
REDIS_URL=redis://default:password@host:6379
